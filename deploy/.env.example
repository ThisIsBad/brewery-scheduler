# Nach deploy/.env kopieren und ausfüllen — deploy/.env bleibt auf dem
# Server und kommt nie ins Repo (.gitignore).

# Domain für automatisches HTTPS (z. B. brauerei.example.de).
# Ohne Domain: ":80" eintragen (kein TLS, aber Basic-Auth bleibt).
SITE_ADDRESS=:80

# Ein Konto je Person — der Benutzername steht später im Protokoll.
# Hash erzeugen mit:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'DEIN-PASSWORT'
# Den Hash in einfache Anführungszeichen setzen, er enthält $-Zeichen.
BASIC_AUTH_USER=vincenz
BASIC_AUTH_HASH=

# Weitere Personen (leer lassen, was nicht gebraucht wird):
BASIC_AUTH_USER_2=
BASIC_AUTH_HASH_2=
BASIC_AUTH_USER_3=
BASIC_AUTH_HASH_3=
BASIC_AUTH_USER_4=
BASIC_AUTH_HASH_4=

# Postgres-Passwort (nur intern zwischen den Containern).
POSTGRES_PASSWORD=
