# SITE_ADDRESS: eine Domain (z. B. brauerei.example.de) -> automatisches
# HTTPS via Let's Encrypt. Nur eine IP ohne Domain? Dann ":80" eintragen —
# ohne TLS, aber weiterhin hinter Basic-Auth.
{$SITE_ADDRESS} {
	# Je Person ein eigenes Konto — der Benutzername landet im Protokoll,
	# ein gemeinsames Konto wäre dort wertlos. Die Liste schreibt
	# caddy-entrypoint.sh beim Start aus deploy/.env.
	basic_auth {
		import /etc/caddy/benutzer.caddy
	}

	handle /api/* {
		reverse_proxy backend:8000 {
			# Überschreibt, was der Client geschickt hat — das Backend
			# darf dem Namen nur glauben, weil er hier gesetzt wird.
			header_up X-Authenticated-User {http.auth.user.id}
		}
	}

	handle {
		root * /srv

		# Gebaute Dateien tragen ihren Inhalt im Namen — eine neue Fassung
		# heißt anders, die alte darf ewig im Cache bleiben.
		@unveraenderlich path /assets/*
		header @unveraenderlich Cache-Control "public, max-age=31536000, immutable"

		# Alles andere entscheidet über die Version: Einstiegsseite,
		# Service Worker, Manifest. Ohne Revalidierung hält ein Handy
		# tagelang an der alten Fassung fest (2026-08-07 in freier Wildbahn
		# beobachtet) — dann kommt kein Update mehr an.
		@fluechtig not path /assets/*
		header @fluechtig Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
